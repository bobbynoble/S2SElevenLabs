# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-key
# Override once ElevenLabs confirms a UK/EU-resident processing endpoint for this account.
# The default below is the global endpoint and is NOT confirmed to satisfy UK-only data residency.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_DEFAULT_VOICE_ID=your-multilingual-voice-id
# Used to estimate the ElevenLabs API cost shown to the receptionist at the end of a session.
# Defaults match this workspace's own Enterprise API rates (see Subscription.docx) -- override
# if your plan/rates differ.
ELEVENLABS_STT_PRICE_PER_HOUR=0.22
ELEVENLABS_TTS_PRICE_PER_1M_CHARS=100.00
# 0-4; higher trades a little pronunciation accuracy for lower time-to-first-audio-chunk on the
# streaming TTS reply. Not accepted by eleven_v3 at all, so has no effect on languages that use it.
ELEVENLABS_TTS_STREAMING_LATENCY=2

# Anthropic (translation step, and post-session clinical coding)
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-haiku-4-5
# Stronger model for languages the default mistranslates (either side of the turn).
ANTHROPIC_LANGUAGE_MODELS=so:claude-opus-5-5,ps:claude-sonnet-5,pa:claude-sonnet-5
# Reserved. Only set once UK-residency routing for the translation step is confirmed with
# Anthropic (e.g. an enterprise DPA, or routing via AWS Bedrock's London region instead).
# ANTHROPIC_BASE_URL=

# Kiosk / session provisioning auth
# Optional. When set, POST /api/sessions requires header: X-API-Key: <value>
SESSION_API_KEY=
SESSION_TTL_MINUTES=30

# Clinical coding
# Runs locally once a receptionist ends a session (small curated reference set + Claude via
# ANTHROPIC_API_KEY above) -- no extra config needed. Kill switch: set to false to skip this
# step entirely instead of surfacing a coding error to the receptionist.
CLINICAL_CODING_ENABLED=true

# CORS
CORS_ORIGINS=*

# Absolute origin the patient's phone will load when scanning the QR code
FRONTEND_ORIGIN=http://localhost:5173
